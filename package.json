{
  "name": "hrms-backend",
  "version": "1.1.0",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "demo": "tsx --env-file-if-exists=.env src/db/demo.ts",
    "bootstrap": "tsx --env-file-if-exists=.env src/db/bootstrap.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate:status": "tsx --env-file-if-exists=.env src/db/migrate.ts --status",
    "migrate:down": "tsx --env-file-if-exists=.env src/db/migrate.ts --rollback",
    "openapi": "tsx scripts/openapi.ts",
    "rotate-keys": "tsx --env-file-if-exists=.env src/db/rotate-keys.ts"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1162.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.9.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "description": "HRMS API (Fastify + PostgreSQL)",
  "engines": {
    "node": ">=24.7"
  }
}
