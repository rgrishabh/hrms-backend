# LOCAL DEVELOPMENT configuration (one installation). Placeholders only: never commit real values.
# The binding reference is docs/CONFIGURATION.md in hrms-deployment. Business settings live in the database.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# api takes traffic; worker (npm run worker) runs jobs and sends email.
PROCESS_ROLE=api

# ---- Database. The runtime role must NOT be superuser or BYPASSRLS (the server refuses to start otherwise).
DATABASE_URL=postgres://hrms_app:CHANGE_ME@localhost:5432/hrms_dev
# Schema-owner role, used only by migrations.
DATABASE_MIGRATION_URL=postgres://hrms_owner:CHANGE_ME@localhost:5432/hrms_dev
DATABASE_POOL_MAX=20
# Production requires an explicit DATABASE_SSL.
DATABASE_SSL=disable
# Optional cache for config and lookups. Without it the app reads the database: slower, still correct.
REDIS_URL=

LOG_LEVEL=info
SESSION_TTL_HOURS=12
# API requests per minute per client IP (staff behind one office NAT share it); sign-in has its own stricter limits.
RATE_LIMIT_PER_MINUTE=3000
# Must be true in production (HTTPS). false only for local http development.
COOKIE_SECURE=false
# false, a number of proxy hops in front of the app, or comma-separated proxy addresses or CIDRs. true means one hop.
TRUST_PROXY=false

# base64 of 32 random bytes: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
DATA_ENCRYPTION_KEY=

# ---- Layer 1: modes and security
ORG_MANAGEMENT_MODE=multi
MFA_AVAILABLE=false
MFA_ENFORCED=false
MFA_METHODS=

# ---- Layer 1: features. Only those differing from the registry defaults are needed (src/core/features/registry.ts).
FEATURE_ATTENDANCE_MOBILE=true
FEATURE_ATTENDANCE_BIOMETRIC=true

# ---- Email. Mailpit in development: on when SMTP_HOST is set and FEATURE_EMAIL_NOTIFICATIONS=true.
SMTP_HOST=
SMTP_PORT=1025
# starttls | tls | none. Production refuses none.
SMTP_SECURE=none
SMTP_USER=
SMTP_PASSWORD=

# ---- Web push (FEATURE_PUSH_NOTIFICATIONS). Base64url of a P-256 key pair; without them it answers feature_not_configured.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https:// contact for the push services. Defaults to mailto:BRAND_SUPPORT_EMAIL.
VAPID_SUBJECT=

# ---- Documents: a local folder in development, S3 in production. S3_ENDPOINT is for MinIO.
STORAGE_DRIVER=local
STORAGE_PATH=../../storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
S3_ENDPOINT=

# ---- Layer 2: brand and client identity. Brand files are mounted at /brand and referenced as /brand/<file>.
BRAND_NAME=Demo Labs
BRAND_PRODUCT_NAME=LabHRMS
BRAND_LEGAL_NAME=Demo Environmental Labs
BRAND_LOGO_URL=
BRAND_LOGO_DARK_URL=
BRAND_FAVICON_URL=
# Quote colours: an unquoted # starts a comment in .env files.
BRAND_PRIMARY_COLOR="#0F5C7A"
BRAND_SECONDARY_COLOR="#0F172A"
BRAND_ACCENT_COLOR="#2F855A"
# Inter, Source Sans 3 or Noto Sans
BRAND_FONT_FAMILY=
BRAND_SUPPORT_EMAIL=support@example.test
BRAND_EMAIL_FROM=hrms@example.test
BRAND_SUPPORT_PHONE=
BRAND_HELP_URL=
BRAND_LOGIN_MESSAGE=Synthetic demo installation: no real employee data.
# Hostname only. The app URL and the only allowed CORS origin come from it.
BRAND_DOMAIN=localhost
BRAND_EXTRA_DOMAINS=
BRAND_LOCALE=en-IN
BRAND_TIMEZONE=Asia/Kolkata
BRAND_CURRENCY=INR
BRAND_DATE_FORMAT=DD/MM/YYYY
BRAND_FINANCIAL_YEAR_START=04-01
BRAND_COUNTRY=IN
