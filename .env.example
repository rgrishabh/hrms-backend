# LOCAL DEVELOPMENT configuration (one installation). Placeholders only — never commit real values.
# Deployed environments are configured in the hrms-deployment repo (Compose .env / Terraform), never here.
# Business settings live in the database and are edited in the app's Settings.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_URL=http://localhost:5173
# Additional hostnames for this installation (comma separated)
APP_EXTRA_DOMAINS=

# Runtime role: must NOT be superuser or BYPASSRLS (server refuses to start otherwise).
DATABASE_URL=postgres://hrms_app:CHANGE_ME@localhost:5432/hrms_dev
# Schema-owner role used only by migrations.
DATABASE_MIGRATION_URL=postgres://hrms_owner:CHANGE_ME@localhost:5432/hrms_dev
DATABASE_POOL_MAX=20

LOG_LEVEL=info
SESSION_TTL_HOURS=12
# API requests per minute per client IP (staff behind one office NAT share it); sign-in has its own stricter limit
RATE_LIMIT_PER_MINUTE=3000
# Must be true in production (HTTPS). false only for local http development.
COOKIE_SECURE=false
# true when running behind an AWS ALB / CloudFront.
TRUST_PROXY=false


# base64 of 32 random bytes: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# Production: injected from AWS Secrets Manager, never stored in source control.
DATA_ENCRYPTION_KEY=

# AWS (production)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Local http only: production requires https APP_URL, COOKIE_SECURE=true and an explicit DATABASE_SSL.
DATABASE_SSL=disable

# Email: development can use MAIL_TRANSPORT=log (records recipient + subject only, never sends)
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=hrms@example.test

# ---- Installation identity & white-label (deployment-controlled, read-only in the app) ----
ENABLED_MODULES=default,attendance.mobile,attendance.biometric
PRODUCT_NAME=LabHRMS
BRAND_NAME=Demo Labs
BRAND_SHORT_NAME=
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
# Quote colours: an unquoted # starts a comment in .env files.
BRAND_PRIMARY_COLOR="#0F5C7A"
BRAND_SECONDARY_COLOR="#0F172A"
BRAND_ACCENT_COLOR="#2F855A"
BRAND_LOGIN_MESSAGE=Synthetic demo installation — no real employee data.
BRAND_SUPPORT_EMAIL=
BRAND_SUPPORT_PHONE=
BRAND_HELP_URL=
BRANDING_DIR=
ORGANIZATION_NAME=Demo Environmental Labs
ORGANIZATION_LEGAL_NAME=
ORGANIZATION_COUNTRY=IN
ORGANIZATION_TIMEZONE=Asia/Kolkata
ORGANIZATION_CURRENCY=INR
ORGANIZATION_DATE_FORMAT=DD/MM/YYYY
ORGANIZATION_FY_START_MONTH=4

# Documents: local folder in development (production: Compose volume or S3)
STORAGE_DRIVER=local
STORAGE_PATH=../../storage

# Two-factor authentication minimum: off | privileged (default) | all. "off" only for local development.
MFA_ENFORCEMENT=off
